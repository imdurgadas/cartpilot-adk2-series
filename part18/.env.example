GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Self-hosted Postgres (docker-compose service name: postgres) ---
POSTGRES_USER=cartpilot
POSTGRES_PASSWORD=change-me-to-something-real
POSTGRES_DB=cartpilot_sessions
# Built from the three values above — used by the cartpilot container.
SESSION_DB_URL=postgresql+asyncpg://cartpilot:change-me-to-something-real@postgres:5432/cartpilot_sessions

# --- Caddy reverse proxy / automatic HTTPS ---
# A real domain pointed at this machine's IP — Caddy requests a
# Let's Encrypt cert for it automatically. Use :80 (no TLS) for local
# testing on a machine with no public domain.
CARTPILOT_DOMAIN=cartpilot.example.com

# --- Self-hosted tracing (Jaeger, OTLP-native) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=cartpilot
