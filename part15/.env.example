# Pick ONE provider: google | openai | anthropic | ollama
CARTPILOT_MODEL_PROVIDER=google

# --- google (native Gemini API — no LiteLLM involved) ---
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- openai (via LiteLLM) ---
OPENAI_API_KEY=your-openai-api-key-here

# --- anthropic (via LiteLLM) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- ollama (fully local, via LiteLLM — no API key needed) ---
# Requires Ollama installed and running: https://ollama.com
# and a tool-calling-capable model pulled, e.g.: ollama pull llama3.2
CARTPILOT_OLLAMA_MODEL_DEFAULT=llama3.2
CARTPILOT_OLLAMA_MODEL_STRONG=qwen2.5:14b
# Only needed if Ollama is running on a different host/port than the default:
# OLLAMA_API_BASE=http://localhost:11434
