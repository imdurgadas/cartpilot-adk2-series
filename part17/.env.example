# Rename this file to .env and fill in your own key.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Part 15/17: which provider to model / actually run against ---
CARTPILOT_MODEL_PROVIDER=google
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CARTPILOT_OLLAMA_MODEL_DEFAULT=llama3.2
CARTPILOT_OLLAMA_MODEL_STRONG=qwen2.5:14b
